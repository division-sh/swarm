@@ -0,0 +1,24 @@
+package construction
+
+import (
+	"fmt"
+	"os"
+	"time"
+)
+
+// PostgresTransportConfig is the explicit disposable transport policy. StallBudget
+// bounds each network call and dial, not a whole transaction or shutdown.
+type PostgresTransportConfig struct {
+	StallBudget time.Duration
+}
+
+// No product default is selected by the disposable #2444 experiment. Every
+// selected-store constructor must explicitly opt into a positive stall budget.
+func postgresTransportConfig() (PostgresTransportConfig, error) {
+	const name = "SWARM_POSTGRES_IO_TIMEOUT"
+	budget, err := time.ParseDuration(os.Getenv(name))
+	if err != nil || budget <= 0 {
+		return PostgresTransportConfig{}, fmt.Errorf("%s must specify a positive duration for the disposable transport experiment", name)
+	}
+	return PostgresTransportConfig{StallBudget: budget}, nil
+}
