+package postgrestransport
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type observedConn struct {
+	net.Conn
+	mu              sync.Mutex
+	readAt, writeAt time.Time
+	entered         chan struct{}
+	enterOnce       sync.Once
+	closes          atomic.Int32
+	closeFailure    error
+	deadlineFailure error
+}
+
+func (c *observedConn) Read(p []byte) (int, error) {
+	c.enterOnce.Do(func() { close(c.entered) })
+	return c.Conn.Read(p)
+}
+
+func (c *observedConn) Write(p []byte) (int, error) {
+	c.enterOnce.Do(func() { close(c.entered) })
+	return c.Conn.Write(p)
+}
+
+func (c *observedConn) SetReadDeadline(at time.Time) error {
+	c.mu.Lock()
+	c.readAt = at
+	c.mu.Unlock()
+	if c.deadlineFailure != nil {
+		return c.deadlineFailure
+	}
+	return c.Conn.SetReadDeadline(at)
+}
+
+func (c *observedConn) SetWriteDeadline(at time.Time) error {
+	c.mu.Lock()
+	c.writeAt = at
+	c.mu.Unlock()
+	if c.deadlineFailure != nil {
+		return c.deadlineFailure
+	}
+	return c.Conn.SetWriteDeadline(at)
+}
+
+func (c *observedConn) Close() error {
+	c.closes.Add(1)
+	return errors.Join(c.Conn.Close(), c.closeFailure)
+}
+
+func socketPair(t *testing.T, timeout time.Duration) (*deadlineConn, *observedConn, net.Conn) {
+	t.Helper()
+	client, peer := net.Pipe()
+	observed := &observedConn{Conn: client, entered: make(chan struct{})}
+	conn := &deadlineConn{Conn: observed, timeout: timeout}
+	t.Cleanup(func() { _ = conn.Close(); _ = peer.Close() })
+	return conn, observed, peer
+}
+
+func awaitIO(t *testing.T, done <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(5 * time.Second):
+		t.Fatal("socket call did not settle")
+		return nil
+	}
+}
+
+func TestDeadlineConnReadWriteExpiry(t *testing.T) {
+	for _, direction := range []string{"read", "write"} {
+		t.Run(direction, func(t *testing.T) {
+			const budget = 50 * time.Millisecond
+			conn, observed, _ := socketPair(t, budget)
+			start := time.Now()
+			var err error
+			if direction == "read" {
+				_, err = conn.Read(make([]byte, 1))
+			} else {
+				_, err = conn.Write([]byte{1})
+			}
+			if !errors.Is(err, os.ErrDeadlineExceeded) || errors.Is(err, context.Canceled) {
+				t.Fatalf("expiry = %v", err)
+			}
+			if elapsed := time.Since(start); elapsed < budget || elapsed > 3*time.Second {
+				t.Fatalf("expiry took %s for budget %s", elapsed, budget)
+			}
+			if observed.closes.Load() != 1 {
+				t.Fatal("expiry did not close exact socket")
+			}
+			if err := conn.SetDeadline(time.Time{}); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("expired socket deadline was revived: %v", err)
+			}
+			if _, err := conn.Write([]byte{2}); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("unsafe successor = %v", err)
+			}
+			_ = conn.Close()
+			if observed.closes.Load() != 1 {
+				t.Fatal("socket disposed more than once")
+			}
+		})
+	}
+}
+
+func TestDeadlineConnComposesExternalDeadlines(t *testing.T) {
+	for _, direction := range []string{"read", "write"} {
+		for _, change := range []string{"preserve_earlier", "clear_during_io", "extend_during_io", "shorten_during_io"} {
+			t.Run(direction+"/"+change, func(t *testing.T) {
+				conn, observed, _ := socketPair(t, 150*time.Millisecond)
+				external := time.Now().Add(time.Second)
+				if change == "preserve_earlier" {
+					external = time.Now().Add(50 * time.Millisecond)
+				}
+				if err := conn.SetDeadline(external); err != nil {
+					t.Fatal(err)
+				}
+				done := make(chan error, 1)
+				go func() {
+					var err error
+					if direction == "read" {
+						_, err = conn.Read(make([]byte, 1))
+					} else {
+						_, err = conn.Write([]byte{1})
+					}
+					done <- err
+				}()
+				<-observed.entered
+				observed.mu.Lock()
+				initial := observed.readAt
+				if direction == "write" {
+					initial = observed.writeAt
+				}
+				observed.mu.Unlock()
+				want := initial
+				switch change {
+				case "preserve_earlier":
+					want = external
+				case "clear_during_io":
+					external = time.Time{}
+				case "extend_during_io":
+					external = time.Now().Add(time.Hour)
+				case "shorten_during_io":
+					external = time.Now().Add(25 * time.Millisecond)
+					want = external
+				}
+				if err := conn.SetDeadline(external); err != nil {
+					t.Fatal(err)
+				}
+				observed.mu.Lock()
+				got := observed.readAt
+				if direction == "write" {
+					got = observed.writeAt
+				}
+				observed.mu.Unlock()
+				if !got.Equal(want) {
+					t.Errorf("effective deadline = %s, want %s", got, want)
+				}
+				if err := awaitIO(t, done); !errors.Is(err, os.ErrDeadlineExceeded) {
+					t.Fatalf("earliest deadline did not expire: %v", err)
+				}
+			})
+		}
+	}
+}
+
+func TestDeadlineConnProgressIsNotTotalDrainDeadline(t *testing.T) {
+	const budget = 200 * time.Millisecond
+	conn, _, peer := socketPair(t, budget)
+	done := make(chan error, 1)
+	go func() {
+		for i := 0; i < 5; i++ {
+			time.Sleep(budget / 2)
+			if _, err := peer.Write([]byte{byte(i)}); err != nil {
+				done <- err
+				return
+			}
+		}
+		done <- nil
+	}()
+	start := time.Now()
+	if _, err := io.ReadFull(conn, make([]byte, 5)); err != nil {
+		t.Fatal(err)
+	}
+	if err := awaitIO(t, done); err != nil {
+		t.Fatal(err)
+	}
+	if time.Since(start) <= budget || conn.closed.Load() {
+		t.Fatal("progress was treated as a total-operation deadline")
+	}
+}
+
+func TestDeadlineConnPreservesFailureAndDisposalError(t *testing.T) {
+	conn, observed, _ := socketPair(t, time.Second)
+	primary := errors.New("cannot set socket deadline")
+	cleanup := errors.New("socket close failed")
+	observed.deadlineFailure, observed.closeFailure = primary, cleanup
+	_, err := conn.Read(make([]byte, 1))
+	var network *net.OpError
+	if !errors.Is(err, primary) || !errors.Is(err, cleanup) || !errors.As(err, &network) || observed.closes.Load() != 1 {
+		t.Fatalf("failure/disposal evidence = %v, closes=%d", err, observed.closes.Load())
+	}
+}
+
+func TestConnectorRequiresPositiveBudget(t *testing.T) {
+	for _, budget := range []time.Duration{0, -time.Second} {
+		if _, err := NewConnector("", budget); err == nil {
+			t.Fatalf("accepted invalid budget %s", budget)
+		}
+	}
+}
+
+func TestConnectorPreCanceledDial(t *testing.T) {
+	connector, err := NewConnector("host=127.0.0.1 port=1 sslmode=disable", time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = connector.Connect(ctx)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled dial = %v", err)
+	}
+}
+
+func TestConnectorEarlierStartupAuthTLSDeadline(t *testing.T) {
+	for _, phase := range []string{"startup", "auth", "tls"} {
+		t.Run(phase, func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			done := make(chan error, 1)
+			go func() {
+				peer, err := listener.Accept()
+				if err != nil {
+					done <- err
+					return
+				}
+				defer peer.Close()
+				_ = peer.SetDeadline(time.Now().Add(4 * time.Second))
+				header := make([]byte, 4)
+				if _, err := io.ReadFull(peer, header); err != nil {
+					done <- err
+					return
+				}
+				length := int(binary.BigEndian.Uint32(header))
+				if length < 8 || length > 10000 {
+					done <- fmt.Errorf("invalid startup frame length %d", length)
+					return
+				}
+				if _, err := io.CopyN(io.Discard, peer, int64(length-4)); err != nil {
+					done <- err
+					return
+				}
+				if phase == "tls" {
+					_, err = peer.Write([]byte{'S'})
+				} else if phase == "auth" {
+					// Request a password, then stop responding during authentication.
+					_, err = peer.Write([]byte{'R', 0, 0, 0, 8, 0, 0, 0, 3})
+				}
+				if err == nil {
+					_, err = io.Copy(io.Discard, peer)
+				}
+				done <- err
+			}()
+			mode := "disable"
+			if phase == "tls" {
+				mode = "require"
+			}
+			dsn := fmt.Sprintf("host=127.0.0.1 port=%d user=prototype password=prototype dbname=prototype sslmode=%s connect_timeout=1", listener.Addr().(*net.TCPAddr).Port, mode)
+			connector, err := NewConnector(dsn, 3*time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			start := time.Now()
+			conn, err := connector.Connect(context.Background())
+			if err == nil {
+				_ = conn.Close()
+				t.Fatal("incomplete handshake succeeded")
+			}
+			if !errors.Is(err, os.ErrDeadlineExceeded) {
+				t.Fatalf("startup deadline failure = %v", err)
+			}
+			if elapsed := time.Since(start); elapsed < time.Second || elapsed >= 2500*time.Millisecond {
+				t.Fatalf("connect_timeout=1 extended by I/O budget: %s", elapsed)
+			}
+			if err := awaitIO(t, done); err != nil {
+				t.Fatalf("peer not closed after failed handshake: %v", err)
+			}
+		})
+	}
+}
