+package serveapp
+
+import (
+	"context"
+	"database/sql"
+	"io"
+	"net"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/division-sh/swarm/internal/cliapp"
+	"github.com/division-sh/swarm/internal/config"
+	storebackend "github.com/division-sh/swarm/internal/store/backendselection"
+	storeselected "github.com/division-sh/swarm/internal/store/selected"
+	"github.com/division-sh/swarm/internal/testpostgres"
+	"github.com/division-sh/swarm/internal/testutil"
+)
+
+// The fault is byte loss on real TCP connections. No query result or runtime
+// completion is stubbed, and cleanup joins every proxy connection.
+type servePostgresDropProxy struct {
+	listener    net.Listener
+	drop        atomic.Bool
+	dropped     chan struct{}
+	once        sync.Once
+	mu          sync.Mutex
+	connections []net.Conn
+	wg          sync.WaitGroup
+}
+
+func servePostgresProxy(t *testing.T, dsn string) (*servePostgresDropProxy, string) {
+	t.Helper()
+	parsed, err := testpostgres.ParseConnection(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	params := parsed.Parameters()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &servePostgresDropProxy{listener: listener, dropped: make(chan struct{})}
+	p.wg.Add(1)
+	go func() {
+		defer p.wg.Done()
+		for {
+			client, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			p.wg.Add(1)
+			go func() {
+				defer p.wg.Done()
+				defer client.Close()
+				upstream, err := net.DialTimeout("tcp", net.JoinHostPort(params.Host, strconv.Itoa(int(params.Port))), time.Second)
+				if err != nil {
+					return
+				}
+				defer upstream.Close()
+				p.mu.Lock()
+				p.connections = append(p.connections, client, upstream)
+				p.mu.Unlock()
+				upload := make(chan struct{})
+				go func() {
+					defer close(upload)
+					_, _ = io.Copy(upstream, client)
+					_ = upstream.Close()
+					_ = client.Close()
+				}()
+				buf := make([]byte, 32768)
+				for {
+					n, err := upstream.Read(buf)
+					if n > 0 {
+						if p.drop.Load() {
+							p.once.Do(func() { close(p.dropped) })
+						} else if _, e := client.Write(buf[:n]); e != nil {
+							break
+						}
+					}
+					if err != nil {
+						break
+					}
+				}
+				_ = upstream.Close()
+				_ = client.Close()
+				<-upload
+			}()
+		}
+	}()
+	t.Cleanup(func() {
+		_ = listener.Close()
+		p.mu.Lock()
+		for _, conn := range p.connections {
+			_ = conn.Close()
+		}
+		p.mu.Unlock()
+		p.wg.Wait()
+	})
+	u := &url.URL{Scheme: "postgres", Host: listener.Addr().String(), Path: "/" + params.Database, User: url.UserPassword(params.User, params.Password)}
+	u.RawQuery = url.Values{"sslmode": {"disable"}, "application_name": {"swarm_2444_serve_probe"}}.Encode()
+	return p, u.String()
+}
+
+func TestServePostgresAutomaticStallSettlement(t *testing.T) {
+	for _, phase := range []string{"startup", "ownership", "shutdown", "active_shutdown", "healthy"} {
+		t.Run(phase, func(t *testing.T) {
+			t.Setenv("SWARM_POSTGRES_IO_TIMEOUT", "400ms")
+			dsn, observer, cleanup := testutil.StartPostgres(t)
+			t.Cleanup(cleanup)
+			proxy, routedDSN := servePostgresProxy(t, dsn)
+			stubServeRuntimeWorkspaceLifecycle(t)
+			database := make(chan *sql.DB, 1)
+			captureSelectedRuntimePersistence(t, func(p serveRuntimePersistence) {
+				db, _, _ := selectedRuntimeStoreForTest(t, p)
+				database <- db
+			})
+			oldBuild := buildStoresForServe
+			buildStoresForServe = func(ctx context.Context, _ storebackend.Selection, cfg *config.Config) (*selectedStoreOwner, error) {
+				return storeselected.OpenRuntime(ctx, storeselected.RuntimeRequest{Selection: storebackend.Selection{Backend: storebackend.BackendPostgres}, PostgresDSN: routedDSN, SessionLockTTL: runtimeSessionLockTTL(cfg)})
+			}
+			t.Cleanup(func() { buildStoresForServe = oldBuild })
+			if phase == "startup" {
+				proxy.drop.Store(true)
+			}
+			serve := startServeRuntimeTestProcess(t, cliapp.ServeOptions{
+				ConfigPath: writeServeRuntimeTestConfig(t), SourceRoot: filepath.Join("tests", "tier8-boot-verification", "test-boot-success"),
+				PlatformSpecPath: defaultPlatformSpecPath, StoreMode: "postgres", StoreModeSet: true,
+				APIListenAddr: "127.0.0.1:0", MCPListenAddr: "127.0.0.1:0", ShutdownGrace: 50 * time.Millisecond, SelfCheck: true, Verbose: true,
+			})
+			if phase != "startup" {
+				serve.waitForReadyLine()
+				if phase != "healthy" {
+					proxy.drop.Store(true)
+				}
+			}
+			var activeResult chan error
+			if phase == "active_shutdown" {
+				serve.mu.Lock()
+				rt := serve.runtime
+				serve.mu.Unlock()
+				lease, err := rt.WorkOccurrence().Begin(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				db := <-database
+				activeResult = make(chan error, 1)
+				go func() {
+					var n int
+					err := db.QueryRowContext(context.WithoutCancel(lease.Context()), "SELECT 1").Scan(&n)
+					_ = lease.Done()
+					activeResult <- err
+				}()
+				select {
+				case <-proxy.dropped:
+				case <-time.After(5 * time.Second):
+					t.Fatal("active query fault was not reached")
+				}
+				serve.cancel()
+				if code, exited := serve.waitForExit(100 * time.Millisecond); exited {
+					t.Fatalf("serve returned %d before admitted SQL settled", code)
+				}
+			}
+			if phase == "shutdown" || phase == "healthy" {
+				serve.cancel()
+			}
+			if phase != "healthy" {
+				select {
+				case <-proxy.dropped:
+				case <-time.After(5 * time.Second):
+					t.Fatal("fault never intercepted a real server response")
+				}
+			}
+			code, exited := serve.waitForExit(10 * time.Second)
+			if !exited {
+				t.Fatalf("automatic stall settlement did not join serve: %s", serve.outputString())
+			}
+			if phase == "healthy" && code != 0 {
+				t.Fatalf("healthy stop code=%d: %s", code, serve.outputString())
+			}
+			if phase != "healthy" && code == 0 {
+				t.Fatalf("transport failure reported clean shutdown: %s", serve.outputString())
+			}
+			if activeResult != nil {
+				select {
+				case err := <-activeResult:
+					if err == nil || !strings.Contains(err.Error(), "timeout") {
+						t.Fatalf("active SQL lost transport failure: %v", err)
+					}
+				default:
+					t.Fatal("serve returned before SQL worker completed")
+				}
+			}
+			if phase == "startup" && serveOutputIsReady(serve.outputString()) {
+				t.Fatal("stalled startup published readiness")
+			}
+			if phase != "healthy" && !strings.Contains(serve.outputString(), "timeout") && !strings.Contains(serve.outputString(), "ownership") {
+				t.Fatalf("failure explanation missing: %s", serve.outputString())
+			}
+			// This independent backend observes remote release; local socket Close
+			// alone is deliberately not accepted as advisory-release evidence.
+			deadline := time.Now().Add(3 * time.Second)
+			for {
+				var count int
+				err := observer.QueryRow(`SELECT count(*) FROM pg_locks l JOIN pg_stat_activity a ON a.pid=l.pid WHERE l.locktype='advisory' AND a.application_name='swarm_2444_serve_probe' AND a.datname=current_database()`).Scan(&count)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if count == 0 {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatalf("%d remote advisory locks survived completed serve", count)
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			t.Logf("phase=%s code=%d; exact serve joined; remote advisory locks absent\n%s", phase, code, serve.outputString())
+		})
+	}
+}
