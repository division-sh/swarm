@@ -0,0 +1,38 @@
+package construction
+
+import (
+	"testing"
+	"time"
+)
+
+func TestPostgresConstructorRequiresExplicitTransportBudget(t *testing.T) {
+	for _, value := range []string{"", "0s", "-1s", "invalid"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("SWARM_POSTGRES_IO_TIMEOUT", value)
+			store, db, err := OpenPostgres("host=127.0.0.1 port=1 sslmode=disable")
+			if err == nil || store != nil || db != nil {
+				t.Fatalf("invalid transport policy admitted: %v", err)
+			}
+		})
+	}
+	t.Setenv("SWARM_POSTGRES_IO_TIMEOUT", "2s")
+	store, db, err := OpenPostgres("host=127.0.0.1 port=1 sslmode=disable")
+	if err != nil || store == nil || db == nil {
+		t.Fatalf("explicit transport policy refused: %v", err)
+	}
+	_ = db.Close()
+}
+
+func TestPostgresExplicitTransportConstructor(t *testing.T) {
+	t.Setenv("SWARM_POSTGRES_IO_TIMEOUT", "")
+	for _, budget := range []time.Duration{0, -time.Second} {
+		if _, _, err := OpenPostgresWithTransport("", PostgresTransportConfig{StallBudget: budget}); err == nil {
+			t.Fatalf("explicit constructor accepted invalid budget %s", budget)
+		}
+	}
+	store, db, err := OpenPostgresWithTransport("host=127.0.0.1 port=1 sslmode=disable", PostgresTransportConfig{StallBudget: time.Second})
+	if err != nil || store == nil || db == nil {
+		t.Fatalf("explicit constructor depended on environment: %v", err)
+	}
+	_ = db.Close()
+}
