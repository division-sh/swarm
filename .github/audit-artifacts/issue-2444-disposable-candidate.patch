--- /dev/null
+++ b/internal/store/internal/postgrestransport/postgres_test.go
@@ -0,0 +1,372 @@
+package postgrestransport_test
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/url"
+	"os"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/division-sh/swarm/internal/store/internal/postgrestransport"
+	"github.com/division-sh/swarm/internal/testpostgres"
+	"github.com/division-sh/swarm/internal/testutil"
+)
+
+// This test proxy drops bytes, not interpreted SQL. The unchanged public pq
+// connector still dials the listener and owns its real deadline-wrapped socket.
+type responseDropProxy struct {
+	listener net.Listener
+	drop     atomic.Bool
+	dropped  chan struct{}
+	once     sync.Once
+	wg       sync.WaitGroup
+	mu       sync.Mutex
+	sockets  []net.Conn
+}
+
+func startResponseDropProxy(t *testing.T, dsn string) (*responseDropProxy, string) {
+	t.Helper()
+	source, err := testpostgres.ParseConnection(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	params := source.Parameters()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &responseDropProxy{listener: listener, dropped: make(chan struct{})}
+	p.wg.Add(1)
+	go func() {
+		defer p.wg.Done()
+		client, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer client.Close()
+		upstream, err := net.DialTimeout("tcp", net.JoinHostPort(params.Host, strconv.Itoa(int(params.Port))), time.Second)
+		if err != nil {
+			return
+		}
+		defer upstream.Close()
+		p.mu.Lock()
+		p.sockets = append(p.sockets, client, upstream)
+		p.mu.Unlock()
+		uploadDone := make(chan struct{})
+		go func() {
+			defer close(uploadDone)
+			_, _ = io.Copy(upstream, client)
+			_ = upstream.Close()
+			_ = client.Close()
+		}()
+		buffer := make([]byte, 32768)
+		for {
+			n, readErr := upstream.Read(buffer)
+			if n > 0 {
+				if p.drop.Load() {
+					p.once.Do(func() { close(p.dropped) })
+				} else if _, err := client.Write(buffer[:n]); err != nil {
+					break
+				}
+			}
+			if readErr != nil {
+				break
+			}
+		}
+		_ = client.Close()
+		_ = upstream.Close()
+		<-uploadDone
+	}()
+	t.Cleanup(func() {
+		_ = listener.Close()
+		p.mu.Lock()
+		for _, socket := range p.sockets {
+			_ = socket.Close()
+		}
+		p.mu.Unlock()
+		p.wg.Wait()
+	})
+	u := &url.URL{Scheme: "postgres", Host: listener.Addr().String(), Path: "/" + params.Database, User: url.UserPassword(params.User, params.Password)}
+	query := url.Values{"sslmode": {"disable"}, "connect_timeout": {"1"}, "statement_timeout": {"500"}}
+	u.RawQuery = query.Encode()
+	return p, u.String()
+}
+
+func TestPublicTransportPostgresResponseLoss(t *testing.T) {
+	dsn, observer, _ := testutil.StartPostgres(t)
+	if _, err := observer.Exec("CREATE TABLE transport_settlement_proof(n integer)"); err != nil {
+		t.Fatal(err)
+	}
+	for i, phase := range []string{"query", "prepared_exec", "rows_next", "rows_close", "begin", "commit", "rollback"} {
+		t.Run(phase, func(t *testing.T) {
+			proxy, proxyDSN := startResponseDropProxy(t, dsn)
+			connector, err := postgrestransport.NewConnector(proxyDSN, 250*time.Millisecond)
+			if err != nil {
+				t.Fatal(err)
+			}
+			db := sql.OpenDB(connector)
+			defer db.Close()
+			conn, err := db.Conn(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			lock := int64(2444000 + i)
+			if _, err := conn.ExecContext(context.Background(), "SELECT pg_advisory_lock($1)", lock); err != nil {
+				t.Fatal(err)
+			}
+			var held bool
+			if err := observer.QueryRow("SELECT pg_try_advisory_lock($1)", lock).Scan(&held); err != nil || held {
+				t.Fatalf("initial exclusive possession=%t, %v", held, err)
+			}
+			var tx *sql.Tx
+			if phase != "begin" {
+				tx, err = conn.BeginTx(context.Background(), nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer tx.Rollback()
+			}
+			var statement *sql.Stmt
+			var rows *sql.Rows
+			if phase == "prepared_exec" {
+				statement, err = tx.Prepare("SELECT $1::integer")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer statement.Close()
+			}
+			if phase == "rows_next" || phase == "rows_close" {
+				rows, err = tx.Query("SELECT i, repeat('x', 8192), pg_sleep(0.002) FROM generate_series(1, 1000) i")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer rows.Close()
+				if !rows.Next() {
+					t.Fatalf("first row absent: %v", rows.Err())
+				}
+			}
+			if phase == "commit" || phase == "rollback" {
+				if _, err := tx.Exec("INSERT INTO transport_settlement_proof VALUES ($1)", i); err != nil {
+					t.Fatal(err)
+				}
+			}
+			proxy.drop.Store(true)
+			start := time.Now()
+			switch phase {
+			case "begin":
+				tx, err = conn.BeginTx(context.Background(), nil)
+				if err == nil {
+					_ = tx.Rollback()
+					t.Fatal("lost BEGIN response reported success")
+				}
+			case "commit":
+				err = tx.Commit()
+			case "rollback":
+				err = tx.Rollback()
+			case "prepared_exec":
+				_, err = statement.Exec(41)
+			case "rows_next":
+				for rows.Next() {
+				}
+				err = errors.Join(rows.Err(), rows.Close())
+			case "rows_close":
+				err = rows.Close()
+			default:
+				_, err = tx.Exec("SELECT 41")
+			}
+			if !errors.Is(err, os.ErrDeadlineExceeded) || errors.Is(err, context.Canceled) {
+				t.Fatalf("lost %s response did not retain network expiry: %v", phase, err)
+			}
+			select {
+			case <-proxy.dropped:
+			default:
+				t.Fatal("no actual PostgreSQL response was dropped")
+			}
+			if elapsed := time.Since(start); elapsed > 3*time.Second {
+				t.Fatalf("automatic expiry took %s", elapsed)
+			}
+			if tx != nil {
+				_ = tx.Rollback()
+			}
+			if _, err := conn.ExecContext(context.Background(), "SELECT 1"); err == nil {
+				t.Fatal("unsafe successor admitted")
+			}
+			// Observe server-side possession independently; client close alone is
+			// not credited as proof that the advisory lock was released.
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			proofConn, err := observer.Conn(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer proofConn.Close()
+			for {
+				if err := proofConn.QueryRowContext(ctx, "SELECT pg_try_advisory_lock($1)", lock).Scan(&held); err != nil {
+					t.Fatalf("server advisory release unconfirmed: %v", err)
+				}
+				if held {
+					_, err = proofConn.ExecContext(ctx, "SELECT pg_advisory_unlock($1)", lock)
+					if err != nil {
+						t.Fatal(err)
+					}
+					break
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			if phase == "commit" || phase == "rollback" {
+				var count int
+				if err := observer.QueryRowContext(ctx, "SELECT count(*) FROM transport_settlement_proof WHERE n=$1", i).Scan(&count); err != nil {
+					t.Fatal(err)
+				}
+				want := 0
+				if phase == "commit" {
+					want = 1
+				}
+				if count != want {
+					t.Fatalf("actual %s state=%d, want %d", phase, count, want)
+				}
+			}
+			t.Log(fmt.Sprintf("%s: native response dropped, automatic timeout, unsafe successor rejected, advisory release observed", phase))
+		})
+	}
+}
+
+func TestPublicTransportPostgresHealthySilentQueryExpiry(t *testing.T) {
+	dsn, observer, _ := testutil.StartPostgres(t)
+	const budget = 100 * time.Millisecond
+	connector, err := postgrestransport.NewConnector(dsn, budget)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := sql.OpenDB(connector)
+	defer db.Close()
+	conn, err := db.Conn(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	// Isolate transport expiry from server cancellation. With periodic peer
+	// checks disabled, a sleeping backend can retain its lock after local close.
+	if _, err := conn.ExecContext(context.Background(), "SET statement_timeout = 0; SET client_connection_check_interval = 0"); err != nil {
+		t.Fatal(err)
+	}
+	var pid int
+	if err := conn.QueryRowContext(context.Background(), "SELECT pg_backend_pid()").Scan(&pid); err != nil {
+		t.Fatal(err)
+	}
+	const lock = int64(2444100)
+	if _, err := conn.ExecContext(context.Background(), "SELECT pg_advisory_lock($1)", lock); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	proofConn, err := observer.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer proofConn.Close()
+
+	start := time.Now()
+	_, err = conn.ExecContext(context.Background(), "SELECT pg_sleep(0.6)")
+	expiredAfter := time.Since(start)
+	if !errors.Is(err, os.ErrDeadlineExceeded) || errors.Is(err, context.Canceled) {
+		t.Fatalf("healthy silent query did not fail with transport expiry: %v", err)
+	}
+	if _, err := conn.ExecContext(context.Background(), "SELECT 1"); err == nil {
+		t.Fatal("unsafe successor admitted after healthy-query transport expiry")
+	}
+	var sleeping bool
+	if err := proofConn.QueryRowContext(ctx, `SELECT EXISTS (
+		SELECT 1 FROM pg_stat_activity WHERE pid = $1 AND state = 'active' AND wait_event = 'PgSleep'
+	)`, pid).Scan(&sleeping); err != nil || !sleeping {
+		t.Fatalf("healthy backend no longer observed sleeping after local expiry (%s): sleeping=%t, %v", expiredAfter, sleeping, err)
+	}
+	var acquired bool
+	if err := proofConn.QueryRowContext(ctx, "SELECT pg_try_advisory_lock($1)", lock).Scan(&acquired); err != nil {
+		t.Fatal(err)
+	}
+	// Always balance an independent acquisition, including an unexpected early
+	// one: returning a pooled sql.Conn does not release session advisory locks.
+	defer func() {
+		if acquired {
+			var unlocked bool
+			if err := proofConn.QueryRowContext(ctx, "SELECT pg_advisory_unlock($1)", lock).Scan(&unlocked); err != nil || !unlocked {
+				t.Errorf("release independent proof lock: unlocked=%t, %v", unlocked, err)
+			}
+		}
+	}()
+	if acquired {
+		t.Fatal("expected the still-sleeping backend to retain its advisory lock after local close")
+	}
+	for !acquired {
+		time.Sleep(10 * time.Millisecond)
+		if err := proofConn.QueryRowContext(ctx, "SELECT pg_try_advisory_lock($1)", lock).Scan(&acquired); err != nil {
+			t.Fatalf("remote advisory release unconfirmed: %v", err)
+		}
+	}
+	t.Logf("healthy silent query: local expiry after %s; unsafe successor rejected; remote backend still sleeping and lock held after expiry; independent acquisition after %s", expiredAfter, time.Since(start))
+}
+
+func TestPublicTransportPostgresStartupResetAndProgress(t *testing.T) {
+	dsn, _, _ := testutil.StartPostgres(t)
+	_, proxyDSN := startResponseDropProxy(t, dsn)
+	const budget = 150 * time.Millisecond
+	connector, err := postgrestransport.NewConnector(proxyDSN, budget)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := sql.OpenDB(connector)
+	defer db.Close()
+	conn, err := db.Conn(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	var before, after int
+	if err := conn.QueryRowContext(context.Background(), "SELECT pg_backend_pid()").Scan(&before); err != nil {
+		t.Fatal(err)
+	}
+	// Neither pq's completed connect_timeout=1 nor an idle socket's previous
+	// call budget may govern the next healthy call.
+	time.Sleep(1100 * time.Millisecond)
+	if err := conn.QueryRowContext(context.Background(), "SELECT pg_backend_pid()").Scan(&after); err != nil || before != after {
+		t.Fatalf("completed startup/idle budget governed successor: %v, same PID=%t", err, before == after)
+	}
+	var timeout string
+	if err := conn.QueryRowContext(context.Background(), "SHOW statement_timeout").Scan(&timeout); err != nil || timeout != "500ms" {
+		t.Fatalf("explicit startup server budget = %q, %v", timeout, err)
+	}
+	stmt, err := conn.PrepareContext(context.Background(), "SELECT i, repeat('x',8192), pg_sleep(0.01) FROM generate_series(1,35) i")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stmt.Close()
+	start := time.Now()
+	rows, err := stmt.QueryContext(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	count := 0
+	for rows.Next() {
+		count++
+	}
+	if err := errors.Join(rows.Err(), rows.Close()); err != nil || count != 35 {
+		t.Fatalf("progressing prepared result = %d rows, %v", count, err)
+	}
+	if time.Since(start) <= budget {
+		t.Fatal("control did not exceed a single socket-call budget")
+	}
+	if err := conn.QueryRowContext(context.Background(), "SELECT pg_backend_pid()").Scan(&after); err != nil || before != after {
+		t.Fatalf("healthy progressing session not retained: %v, same PID=%t", err, before == after)
+	}
+}
