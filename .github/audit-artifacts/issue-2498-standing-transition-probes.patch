+package runtime
+
+import (
+	"context"
+	"testing"
+)
+
+func TestAuditStandingOperatorTransitionAfterRetirement(t *testing.T) {
+	catalog := runtimeAdmissionTestCatalog(t, "a")
+	definition := runtimeAdmissionTestContext(t, runtimeContextTestHashA, "primary", catalog)
+	definition.Runtime.Scheduler = runtimeContextTestScheduler(t, definition.WorkOwner, nil)
+	manager, err := newTestRuntimeContextManager(t, nil, definition)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serviceID := definition.StandingTargets[0].ServiceID
+	transition, err := manager.BeginStandingServiceTransition(context.Background(), serviceID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := transition.Wait(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err := transition.Retire(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	use, _, err := manager.AcquireStandingService(context.Background(), serviceID)
+	if err != nil {
+		t.Fatalf("declared service lost operator context: %v", err)
+	}
+	if err := use.Done(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manager.BeginStandingServiceTransition(context.Background(), serviceID); err != nil {
+		t.Fatalf("loaded retired service cannot reach its next operator transaction: %v", err)
+	}
+}
