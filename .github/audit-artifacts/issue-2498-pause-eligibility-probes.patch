+// This disposable audit probe asserts the defect, not the desired contract.
+func TestAuditStandingOwnedPauseContinueBypassesAuthorityBothStores(t *testing.T) {
+	for _, backend := range []string{"sqlite", "postgres"} {
+		t.Run(backend, func(t *testing.T) {
+			for _, posture := range []string{"suspended", "reset_preserved", "orphaned"} {
