{
  "capability_subjects": [
    {
      "id": "provider.github",
      "kind": "provider_trigger",
      "provider": "github",
      "source": "trigger_pack",
      "provenance": "platform",
      "source_path": "provider-triggers/github",
      "applicability": "installed",
      "status": "AVAILABLE",
      "capabilities": [
        {
          "code": "emit_event",
          "target": "inbound.github.issue_comment_created"
        },
        {
          "code": "emit_event",
          "target": "inbound.github.issue_opened"
        },
        {
          "code": "emit_event",
          "target": "inbound.github.raw.{event_type}"
        },
        {
          "code": "persist_dedupe_markers"
        },
        {
          "code": "receive_https_route",
          "target": "/webhooks/{alias}/github"
        },
        {
          "code": "verify_secret",
          "target": "webhook_signing.github"
        }
      ],
      "guarantees": [
        {
          "code": "emit_undeclared_events",
          "enforced_by": "internal/providertriggers.InboundAdmissionPlan.Accept"
        },
        {
          "code": "run_code_before_admission",
          "enforced_by": "internal/providertriggers.InboundAdmissionPlan.Accept"
        },
        {
          "code": "touch_unbound_resources",
          "enforced_by": "internal/runtime.InboundGateway.HandleResolvedWebhook"
        }
      ],
      "requirements": [
        {
          "kind": "secret",
          "name": "webhook_signing.github",
          "scope": "target"
        }
      ],
      "trigger_events": [
        {
          "event": "inbound.github.issue_comment_created",
          "kind": "normalized",
          "fields": [
            {
              "name": "body",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "comment_author_type",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "installation_id",
              "type": "integer",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "issue_number",
              "type": "integer",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "repository_name",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "repository_owner",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "sender_type",
              "type": "text",
              "required": true,
              "carry_eligible": true
            }
          ]
        },
        {
          "event": "inbound.github.issue_opened",
          "kind": "normalized",
          "fields": [
            {
              "name": "installation_id",
              "type": "integer",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "issue_number",
              "type": "integer",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "repository_name",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "repository_owner",
              "type": "text",
              "required": true,
              "carry_eligible": true
            },
            {
              "name": "title",
              "type": "text",
              "required": true,
              "carry_eligible": true
            }
          ]
        },
        {
          "event": "inbound.github.raw.{event_type}",
          "kind": "raw"
        }
      ]
    },
